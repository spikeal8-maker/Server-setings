# School-specific, least-privilege tailnet ingress for the existing local MCP.
# Installed as /etc/systemd/system/server-settings-school-mcp-tailnet.socket.
[Unit]
Description=School 1Panel MCP - private Tailscale socket (test host only)
Wants=tailscaled.service
After=tailscaled.service

[Socket]
ListenStream=@SCHOOL_TAILSCALE_IP@:39444
BindToDevice=tailscale0
NoDelay=yes
Service=server-settings-school-mcp-tailnet.service
IPAddressDeny=any
IPAddressAllow=@TEST_TAILSCALE_IP@/32

[Install]
WantedBy=sockets.target
